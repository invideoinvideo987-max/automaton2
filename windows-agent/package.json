{
  "name": "automaton-windows",
  "version": "1.0.0",
  "description": "Autonomous AI Agent for Windows - Powered by GitHub Copilot CLI",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "start": "electron dist/main.js",
    "start:agent": "tsx src/agent/loop.ts",
    "ui": "electron .",
    "build:ui": "tsc && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "socket.io": "^4.7.0",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.automaton.windows",
    "productName": "Automaton Agent",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
